// Prisma Schema for Fintech Security & Mobile Data IP / SIM Change Detection System
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SimStatus {
  ACTIVE
  SWAPPED
  REVOKED
  SUSPICIOUS
}

enum NetworkType {
  MOBILE_DATA
  WIFI
  ETHERNET
  VPN_PROXY
  UNKNOWN
}

enum TransactionChannel {
  BKASH
  NAGAD
  ROCKET
  UPAY
  BANK_TRANSFER
  CARD_PAYMENT
}

enum TransactionStatus {
  APPROVED
  CHALLENGE_OTP
  HELD_FOR_REVIEW
  BLOCKED_FRAUD
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  SIM_SWAP_DETECTED
  UNUSUAL_IP_CARRIER
  IMPOSSIBLE_TRAVEL
  VPN_FRAUD_ATTEMPT
  DEVICE_HASH_MISMATCH
  RAPID_VELOCITY_BREACH
}

// 1. User Account
model User {
  id               String            @id @default(uuid())
  phoneNumber      String            @unique
  fullName         String
  email            String?           @unique
  riskTier         RiskTier          @default(LOW)
  isFlagged        Boolean           @default(false)
  lastSimChangeAt  DateTime?
  lastLoginIp      String?
  lastCarrier      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  devices          Device[]
  simCards         SimCardBinding[]
  ipAuditLogs      IpAuditLog[]
  transactions     FintechTransaction[]
  securityAlerts   SecurityAlert[]

  @@index([phoneNumber])
  @@index([riskTier])
}

// 2. Hardware & Device Fingerprinting
model Device {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash           String           @unique // Hash combining Canvas, WebGL, Platform, Hardware
  canvasFingerprint    String           // 2D canvas rendered text & gradient hash
  webglRenderer        String           // WebGL unmasked vendor/renderer string
  platform             String           // e.g. Linux aarch64, Android, Win32
  hardwareConcurrency  Int              // CPU logical cores
  deviceMemoryGb       Float?           // RAM in GB if supported
  screenResolution     String           // e.g. 1080x2400
  isTrusted            Boolean          @default(true)
  firstSeenAt          DateTime         @default(now())
  lastSeenAt           DateTime         @updatedAt

  simCards             SimCardBinding[]
  ipAuditLogs          IpAuditLog[]
  transactions         FintechTransaction[]

  @@index([userId])
  @@index([deviceHash])
}

// 3. SIM Card Bindings & SIM Swap Detection
model SimCardBinding {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String
  device           Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  simSlot          Int          @default(1) // 1 or 2 (Dual SIM)
  iccidHash        String       // SHA-256 hashed ICCID (never store raw ICCID for privacy)
  imsiMasked       String       // e.g. 47001******1234
  carrierName      String       // Grameenphone, Robi, Banglalink, Teletalk
  carrierMccMnc    String       // e.g. 470-01 (GP), 470-02 (Robi)
  operatorAsn      String?      // e.g. AS24389
  status           SimStatus    @default(ACTIVE)
  registeredAt     DateTime     @default(now())
  swappedAt        DateTime?
  lastActiveAt     DateTime     @default(now())

  @@index([userId])
  @@index([iccidHash])
  @@index([status])
}

// 4. IP Audit & Network Carrier Intelligence Logs
model IpAuditLog {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String?
  device          Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  ipAddress       String       // Public client IP
  networkType     NetworkType  // MOBILE_DATA vs WIFI
  connectionTech  String?      // 5G, 4G, LTE, 3G, Broadband
  carrier         String?      // Telecom Carrier or ISP Name
  asn             String?      // e.g. AS24389 Grameenphone Ltd.
  country         String       @default("BD")
  city            String?
  isVpnOrProxy    Boolean      @default(false)
  isTorOrRelay    Boolean      @default(false)
  riskScore       Int          @default(0) // 0 - 100
  matchedSubnet   Boolean      @default(true) // Whether matches user's known telecom subnet
  userAgent       String?
  createdAt       DateTime     @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([asn])
  @@index([createdAt])
}

// 5. FinTech Transactions & Risk Decisions
model FintechTransaction {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("BDT")
  channel        TransactionChannel
  recipient      String             // Destination account / wallet / phone
  clientIp       String
  riskScore      Int                // 0 to 100
  riskFactors    String[]           // Array of triggered risk flags
  status         TransactionStatus  @default(APPROVED)
  blockedReason  String?
  otpChallenged  Boolean            @default(false)
  otpVerified    Boolean            @default(false)
  createdAt      DateTime           @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// 6. Security Incident Alerts & Webhook Logs
model SecurityAlert {
  id                   String         @id @default(uuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  severity             AlertSeverity
  alertType            AlertType
  title                String
  description          String
  ipAddress            String
  carrier              String?
  riskScore            Int
  payloadJson          String?        // Full diagnostic context
  telegramDispatched   Boolean        @default(false)
  telegramMessageId    String?
  isResolved           Boolean        @default(false)
  resolvedAt           DateTime?
  createdAt            DateTime       @default(now())

  @@index([userId])
  @@index([severity])
  @@index([alertType])
  @@index([createdAt])
}

// 7. Dynamic Risk Rules & Scoring Weights
model RiskPolicyRule {
  id             String    @id @default(uuid())
  ruleKey        String    @unique
  name           String
  description    String
  weight         Int       // Risk score added when triggered
  isEnabled      Boolean   @default(true)
  updatedAt      DateTime  @updatedAt
}
