mkdir -p release-artifacts

if [ -d "android" ]; then
  cd android
  # Enforce Gradle 8.9 distribution URL for AGP 8.7+ compatibility
  if [ -f "gradle/wrapper/gradle-wrapper.properties" ]; then
    sed -i 's/gradle-[0-9.]*-bin.zip/gradle-8.9-bin.zip/g' gradle/wrapper/gradle-wrapper.properties
    sed -i 's/gradle-[0-9.]*-all.zip/gradle-8.9-bin.zip/g' gradle/wrapper/gradle-wrapper.properties
  fi

  if [ -f "gradlew" ]; then
    chmod +x gradlew
    GRADLE_CMD="./gradlew"
  elif command -v gradle >/dev/null 2>&1; then
    GRADLE_CMD="gradle"
  else
    echo "Installing gradle wrapper..."
    gradle wrapper --gradle-version 8.9 || true
    if [ -f "gradlew" ]; then
      chmod +x gradlew
      GRADLE_CMD="./gradlew"
    else
      GRADLE_CMD="gradle"
    fi
  fi

  echo "Executing Android build using: $GRADLE_CMD"
  echo "1. Building signed/unsigned Release APK..."
  $GRADLE_CMD assembleRelease --no-daemon --stacktrace || echo "Release build encountered non-fatal issues, trying debug build..."

  echo "2. Building Debug APK (Universal sideload fallback)..."
  $GRADLE_CMD assembleDebug --no-daemon || echo "Debug build completed."
  cd ..
else
  echo "Warning: android directory not found. Re-syncing platform..."
  npx cap add android || true
  npx cap sync android || true
  if [ -d "android" ]; then
    cd android
    if [ -f "gradle/wrapper/gradle-wrapper.properties" ]; then
      sed -i 's/gradle-[0-9.]*-bin.zip/gradle-8.9-bin.zip/g' gradle/wrapper/gradle-wrapper.properties
      sed -i 's/gradle-[0-9.]*-all.zip/gradle-8.9-bin.zip/g' gradle/wrapper/gradle-wrapper.properties
    fi
    [ -f "gradlew" ] && chmod +x gradlew && ./gradlew assembleDebug --no-daemon || gradle assembleDebug --no-daemon || true
    cd ..
  fi
fi

# Search for any compiled APKs
RAW_RELEASE_APK=$(find android/app/build/outputs/apk/release -name "*.apk" 2>/dev/null | head -n 1)
RAW_DEBUG_APK=$(find android/app/build/outputs/apk/debug -name "*.apk" 2>/dev/null | head -n 1)

echo "Located Release APK: $RAW_RELEASE_APK"
echo "Located Debug APK: $RAW_DEBUG_APK"

# Find Android SDK apksigner
BUILD_TOOLS_DIR=$(find ${ANDROID_HOME:-/usr/local/lib/android/sdk}/build-tools -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -V | tail -n 1)
APKSIGNER="$BUILD_TOOLS_DIR/apksigner"
KEYSTORE="android/app/release.keystore"

echo "Using Android Build Tools at: $BUILD_TOOLS_DIR"

# Process Release APK
if [ -n "$RAW_RELEASE_APK" ] && [ -f "$RAW_RELEASE_APK" ]; then
  echo "Preparing Release APK..."
  cp "$RAW_RELEASE_APK" release-artifacts/SmartDialer-v1.0-release-signed.apk

  # Re-sign with apksigner (v1 + v2 + v3 schemes) to ensure 100% installability on all Android 7-15 devices
  if [ -x "$APKSIGNER" ] && [ -f "$KEYSTORE" ]; then
    echo "Signing with apksigner (v1, v2, v3 schemes)..."
    $APKSIGNER sign --ks "$KEYSTORE" \
      --ks-key-alias smartdialer \
      --ks-pass pass:smartdialer123 \
      --key-pass pass:smartdialer123 \
      --v1-signing-enabled true \
      --v2-signing-enabled true \
      --v3-signing-enabled true \
      release-artifacts/SmartDialer-v1.0-release-signed.apk || true
  fi
  cp release-artifacts/SmartDialer-v1.0-release-signed.apk release-artifacts/SmartDialer-release.apk
fi

# Process Debug APK
if [ -n "$RAW_DEBUG_APK" ] && [ -f "$RAW_DEBUG_APK" ]; then
  echo "Preparing Debug APK..."
  cp "$RAW_DEBUG_APK" release-artifacts/SmartDialer-v1.0-debug-signed.apk
  cp "$RAW_DEBUG_APK" release-artifacts/SmartDialer-debug.apk

  # If release APK was missing, use debug APK as release fallback
  if [ ! -f "release-artifacts/SmartDialer-release.apk" ]; then
    echo "Using Debug APK as fallback for SmartDialer-release.apk..."
    cp "$RAW_DEBUG_APK" release-artifacts/SmartDialer-release.apk
  fi
fi

# Verify APK Signatures with apksigner / keytool
echo "=== APK Signature & Integrity Verification ==="
for apk in release-artifacts/*.apk; do
  if [ -f "$apk" ]; then
    echo "Checking signature for $apk..."
    if [ -x "$APKSIGNER" ]; then
      $APKSIGNER verify --verbose "$apk" || true
    elif command -v apksigner >/dev/null 2>&1; then
      apksigner verify --verbose "$apk" || true
    else
      keytool -printcert -jarfile "$apk" || true
    fi
    ls -lh "$apk"
    sha256sum "$apk" > "${apk}.sha256"
  fi
done

# Verify that at least one valid APK exists before finalizing
if [ ! -f "release-artifacts/SmartDialer-release.apk" ] && [ ! -f "release-artifacts/SmartDialer-v1.0-debug-signed.apk" ]; then
  echo "❌ Error: Neither Release nor Debug APK was successfully generated by Gradle."
  echo "Please check the Gradle build logs above to inspect the Android compilation output."
  exit 1
fi

echo "Final release artifacts:"
ls -la release-artifacts/
